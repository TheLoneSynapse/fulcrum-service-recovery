# Fulcrum Service Recovery — environment variables (NAMES ONLY; never commit values).
# Without a configured provider the service runs the clearly-labelled local-heuristic
# stub backend and never claims an AMD inference occurred.

# --- Store durability ---------------------------------------------------------
# SQLite file for cases/audit trail (default if unset:
#   data/fulcrum_cases.sqlite at the project root; survives restarts).
# Set to :memory: for a throwaway in-memory store (used by tests/evals).
FULCRUM_STORE_PATH=

# Provider selection: auto | token-factory | mi300x-gpu | stub  (default: auto)
# auto = first configured real provider, else the labelled stub.
# An explicitly selected provider that is NOT configured fails closed
# (INFERENCE_FAILED) — it never silently falls back to the stub.
AMD_PROVIDER=

# --- AMD Token Factory (Deliverable #1 target; OpenAI-compatible) -----------
# Base URL of the Token Factory endpoint (default applied if unset:
# https://developer.amd.com.cn/radeon/api/v1 — confirm against the event portal)
AMD_API_BASE=

# API key / token for that endpoint (keep private; never commit)
# Issued when the Token Factory console/profile is first opened.
AMD_API_KEY=

# Model identifier to request; leave unset to pick the first id from GET /v1/models
AMD_MODEL=

# Optional: request timeout in seconds (default 30)
AMD_API_TIMEOUT=30

# --- Dedicated GPU slot (MI300X — configure when the lab confirms availability)
MI300X_API_BASE=
MI300X_API_KEY=
MI300X_MODEL=
MI300X_API_TIMEOUT=30