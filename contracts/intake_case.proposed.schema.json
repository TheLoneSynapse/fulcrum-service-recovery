{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntakeCase \u2014 PROPOSED",
  "type": "object",
  "required": [
    "case_id",
    "source",
    "complaint_text",
    "policy_version",
    "created_at_utc"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "source": {
      "enum": [
        "web_form",
        "manual",
        "csv_fixture"
      ]
    },
    "complaint_text": {
      "type": "string",
      "minLength": 1
    },
    "order_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "fixture_only": {
      "const": true
    }
  },
  "additionalProperties": false
}
