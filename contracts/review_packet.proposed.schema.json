{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManagerReviewPacket \u2014 PROPOSED",
  "type": "object",
  "required": [
    "case_id",
    "outcome",
    "draft_response",
    "evidence_refs",
    "missing_facts",
    "policy_version",
    "recommendation",
    "created_at_utc",
    "manager_decision",
    "amd_inference"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "SUPPORTED_DRAFT",
        "REVIEW_REQUIRED",
        "INFERENCE_FAILED"
      ]
    },
    "draft_response": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_version": {
      "type": "string"
    },
    "recommendation": {
      "enum": [
        "APPROVE_DRAFT",
        "MANUAL_REVIEW",
        "FIX_INFERENCE"
      ]
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "manager_decision": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "REQUEST_INFO"
      ]
    },
    "amd_inference": {
      "type": "object",
      "required": [
        "attempted",
        "verified"
      ],
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
